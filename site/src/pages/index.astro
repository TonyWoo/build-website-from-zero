---
// 《从零开始学习建网站》首页：直接展示内容 —— 前言 + 18 章直达，无版本选择
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;

const base = import.meta.env.BASE_URL;

const chapters = [
  { slug: "preface", title: "写在前面：零基础也能学会建网站" },
  { slug: "meet-web", title: "第 1 章 认识 Web：网页是怎么跑起来的" },
  { slug: "tools", title: "第 2 章 工欲善其事：装好你的工具箱" },
  { slug: "html-basics", title: "第 3 章 HTML 入门：写出你的第一个网页" },
  { slug: "html-advanced", title: "第 4 章 HTML 进阶：做一张完整的个人主页" },
  { slug: "css-basics", title: "第 5 章 CSS 入门：给网页化妆" },
  { slug: "css-layout", title: "第 6 章 CSS 布局：把页面排整齐" },
  { slug: "css-advanced", title: "第 7 章 CSS 进阶：好看又好用" },
  { slug: "js-basics", title: "第 8 章 JavaScript 入门：先在控制台玩起来" },
  { slug: "js-logic", title: "第 9 章 逻辑与函数：把重复的事交给代码" },
  { slug: "js-dom", title: "第 10 章 DOM 与事件：让网页动起来" },
  { slug: "js-advanced", title: "第 11 章 JavaScript 进阶：和真实世界打交道" },
  { slug: "git", title: "第 12 章 Git 版本管理：给你的代码上一份保险" },
  { slug: "react-thinking", title: "第 13 章 React 入门：换个方式想页面" },
  { slug: "react-practice", title: "第 14 章 React 实战：重构小北的网站" },
  { slug: "tailwind", title: "第 15 章 Tailwind CSS：用类名写样式" },
  { slug: "deepseek-companion", title: "第 16 章 认识 DeepSeek：用 AI 当陪练" },
  { slug: "ai-agents", title: "第 17 章 AI 编程代理实战：DeepSeek Harness 与 WorkBuddy" },
  { slug: "launch", title: "第 18 章 毕业作品：把你的网站发布到全世界" },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-4xl w-full px-6 py-16">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>
      <p class="mt-2 text-sm text-muted-foreground">
        著 Tony Wu
      </p>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        全书跟着一个贯穿作品走：大一学生小北，从一张纯 HTML 个人主页开始，
        一路给它美化、加交互、用 Git 管理、重构成 React 应用、换上 Tailwind，
        最后请 AI 编程助手帮忙升级，并亲手发布到全世界都能打开的网址上。
      </p>

      <h2 class="mt-12 text-foreground" style="font-size: var(--nb-h2-size); font-weight: var(--nb-h2-weight);">
        章节
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {chapters.map((c) => (
          <a
            href={withBase(`${c.slug}/`, base)}
            class="block rounded-lg border border-border p-5 transition-colors hover:border-border-strong no-underline"
          >
            <div class="font-medium text-foreground">{c.title}</div>
          </a>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
